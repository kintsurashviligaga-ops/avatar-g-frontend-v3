--- /dev/null
+++ b/lib/orchestrator/stitchSettlement.ts
@@ -0,0 +1,46 @@
+/**
+ * Durable settlement for the /api/video/assemble stitch charge (defect 51).
+ *
+ * The stitch debit is durable (credit_ledger) but its rollback lived only in the function: a stitch killed by the platform
+ * (maxDuration, an OOM, a crash) never reached the refund, and nothing else knew the debit existed. So, right after a
+ * CHARGED debit and before the stitch runs, the route opens a `processing` generation_jobs row carrying
+ * `params._reserve { ref, credits }` — the exact shape the render drainer (lib/pipeline/renderDrainer) refunds from when a
+ * row is still processing 30 min later (a stitch lives at most maxDuration = 600 s, so a row that old is a dead function).
+ *
+ * Exactly once: the drainer refunds `${ref}:refund` (refundDebitByRef, capped at what the ledger shows under `ref`), and the
+ * route's in-route rollbacks use the same `${ref}:refund`, so refund_credits collapses the two to one.
+ * Never on a delivered stitch: the route closes (deletes) the row once the attempt settled in-route — delivered, or refunded
+ * — and leaves it live only when the in-route refund did not land, which is exactly the case the drainer must pick up.
+ *
+ * The row has its own per-attempt id (never the client-supplied film token), so it cannot collide with the Library row
+ * recordCompletedFilm writes, nor with a retry of the same film. Only call with a charge that actually landed: a free slot
+ * or a `skipped` debit has nothing to refund, and stamping it would let the drainer mint credits.
+ */
+import { createJob, discardLiveJob } from './jobs';
+
+export async function openStitchSettlement(input: { id: string; userId: string; ref: string; credits: number }): Promise<boolean> {
+  if (!input.id || !input.userId || !input.ref || !(input.credits > 0)) return false;
+  // Best-effort, never throws: a lost row only forgoes the drainer's backstop — the in-route rollback still covers every
+  // failure the function lives through, and the stitch the user paid for must not be blocked by a bookkeeping write.
+  try {
+    return await createJob({
+      id: input.id,
+      userId: input.userId,
+      serviceType: 'film',
+      status: 'processing',
+      params: { source: 'assemble-settlement', subtype: 'stitch', _reserve: { ref: input.ref, credits: Math.round(input.credits) } },
+    });
+  } catch {
+    return false;
+  }
+}
+
+/** Close a settlement whose attempt settled in-route. Best-effort, never throws; false when nothing (live, owned) was removed. */
+export async function closeStitchSettlement(id: string | null, userId: string | null): Promise<boolean> {
+  if (!id || !userId) return false;
+  try {
+    return await discardLiveJob(id, userId);
+  } catch {
+    return false;
+  }
+}
