+/** @jest-environment node */
+/**
+ * Defect 51 — a function killed mid-stitch kept the stitch debit. The charge is durable (credit_ledger) but the in-route
+ * refund is not: once the platform kills the function there is nothing left that knows the debit exists. The settlement
+ * row opened here, right after the charge and before the stitch, is what the drainer (lib/pipeline/renderDrainer) reads.
+ */
+const rows = new Map<string, Record<string, unknown>>();
+jest.mock('./jobs', () => ({
+  createJob: jest.fn(async (input: { id: string; userId: string; serviceType: string; params?: Record<string, unknown>; status?: string }) => {
+    if (rows.has(input.id)) return false;
+    rows.set(input.id, { id: input.id, user_id: input.userId, service_type: input.serviceType, status: input.status ?? 'pending', params: input.params ?? {}, updated_at: new Date(Date.now() - 31 * 60 * 1000).toISOString() });
+    return true;
+  }),
+  discardLiveJob: jest.fn(async (id: string, userId: string) => {
+    const r = rows.get(id);
+    if (!r || r.user_id !== userId || !['pending', 'processing'].includes(String(r.status))) return false;
+    rows.delete(id);
+    return true;
+  }),
+}));
+
+import { openStitchSettlement, closeStitchSettlement } from './stitchSettlement';
+import { reapReserve, selectReapable, type DrainJobRow } from '../pipeline/renderDrainer';
+
+beforeEach(() => rows.clear());
+
+test('a function killed mid-stitch leaves a processing row the drainer refunds with the exact charge ref and amount', async () => {
+  // The stitch debit landed; the function now opens the settlement and is killed while the stitch runs (nothing after it executes).
+  expect(await openStitchSettlement({ id: 'set-1', userId: 'u1', ref: 'assemble:saga_x', credits: 42 })).toBe(true);
+  const reaped = selectReapable([...rows.values()] as unknown as DrainJobRow[], Date.now());
+  expect(reaped.map((r) => r.id)).toEqual(['set-1']);
+  // The drainer refunds `${ref}:refund` — the SAME ref the in-route rollback uses, so the two collapse to one refund.
+  expect(reapReserve(reaped[0]!)).toEqual({ userId: 'u1', ref: 'assemble:saga_x', credits: 42 });
+});
+
+test('a settled stitch (delivered, or refunded in-route) leaves nothing for the drainer to refund', async () => {
+  await openStitchSettlement({ id: 'set-2', userId: 'u1', ref: 'assemble:saga_y', credits: 42 });
+  expect(await closeStitchSettlement('set-2', 'u1')).toBe(true);
+  expect(selectReapable([...rows.values()] as unknown as DrainJobRow[], Date.now())).toEqual([]);
+});
+
+test('nothing charged, nothing opened (a free slot or skipped debit must never be refundable)', async () => {
+  expect(await openStitchSettlement({ id: 'set-3', userId: 'u1', ref: 'assemble:saga_z', credits: 0 })).toBe(false);
+  expect(await openStitchSettlement({ id: 'set-4', userId: '', ref: 'assemble:saga_z', credits: 5 })).toBe(false);
+  expect(await openStitchSettlement({ id: 'set-5', userId: 'u1', ref: '', credits: 5 })).toBe(false);
+  expect(rows.size).toBe(0);
+});
+
+test('closing never touches another user\'s row, and a null id is a no-op', async () => {
+  await openStitchSettlement({ id: 'set-6', userId: 'u1', ref: 'assemble:saga_w', credits: 7 });
+  expect(await closeStitchSettlement('set-6', 'u2')).toBe(false);
+  expect(await closeStitchSettlement(null, 'u1')).toBe(false);
+  expect(rows.has('set-6')).toBe(true);
+});
+
+test('a settlement write that throws never breaks the stitch (fail-open)', async () => {
+  const jobs = jest.requireMock('./jobs') as { createJob: jest.Mock; discardLiveJob: jest.Mock };
+  jobs.createJob.mockImplementationOnce(async () => { throw new Error('db down'); });
+  jobs.discardLiveJob.mockImplementationOnce(async () => { throw new Error('db down'); });
+  await expect(openStitchSettlement({ id: 'set-7', userId: 'u1', ref: 'assemble:saga_v', credits: 3 })).resolves.toBe(false);
+  await expect(closeStitchSettlement('set-7', 'u1')).resolves.toBe(false);
+});
