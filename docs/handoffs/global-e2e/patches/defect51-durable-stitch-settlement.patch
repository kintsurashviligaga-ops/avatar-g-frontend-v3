index 00000000..73e76f75
--- /dev/null
+++ b/app/api/video/assemble/stitchSettlement.test.ts
@@ -0,0 +1,45 @@
+/** @jest-environment node */
+/**
+ * Defect 51 — structural guard: both charged stitch paths open a durable settlement row after the debit and before the
+ * stitch, refund in-route under `${ref}:refund` (the drainer's ref, so the two collapse to one), close the row only when
+ * the attempt settled in-route, and leave it live when the in-route refund failed.
+ */
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+const src = readFileSync(join(__dirname, 'route.ts'), 'utf8');
+const code = src.replace(/\/\*[\s\S]*?\*\//g, '').split('\n').filter((l) => !/^\s*\/\//.test(l)).join('\n');
+
+test('single clip: the settlement opens right after a charged debit and before the render', () => {
+  const debit = code.indexOf('await deductCredits(uid, assembleCost, scRef)');
+  const open = code.indexOf('openStitchSettlement({ id: scSettleId, userId: uid, ref: scRef, credits: assembleCost })');
+  expect(debit).toBeGreaterThan(0);
+  expect(open).toBeGreaterThan(debit);
+  expect(open).toBeLessThan(code.indexOf('const clipUrl = await reSignIfInternal(segments[0]!.url)'));
+});
+
+test('multi clip: the settlement opens inside reserve-credits after the debit, before dispatch', () => {
+  const debit = code.indexOf('await deductCredits(uid, assembleCost, sagaRef)');
+  const open = code.indexOf('openStitchSettlement({ id: sagaSettleId, userId: uid, ref: sagaRef, credits: assembleCost })');
+  expect(debit).toBeGreaterThan(0);
+  expect(open).toBeGreaterThan(debit);
+  expect(open).toBeLessThan(code.indexOf("name: 'dispatch'"));
+  expect(code).toMatch(/runSaga\(steps, \{ sagaId, signal: req\.signal, bag \}\)/);
+});
+
+test('the saga rollback refunds under the drainer\'s ref (not a private assemble-rollback ref that would pay twice)', () => {
+  expect(code).not.toMatch(/assemble-rollback:/);
+  expect(code).toMatch(/refundCredits\(uid, assembleCost, `\$\{sagaRef\}:refund`\)/);
+});
+
+test('every in-route refund closes the settlement only when it landed; a failed refund leaves the row for the drainer', () => {
+  expect((code.match(/if \(r\?\.ok\) await closeStitchSettlement\(scSettleId, uid\)/g) ?? []).length).toBe(2);
+  expect(code).toMatch(/if \(r\?\.ok\) await closeStitchSettlement\(sagaSettleId, uid\)/);
+});
+
+test('a delivered stitch closes its settlement, so the drainer can never refund it', () => {
+  const single = code.indexOf('if (scLock) await commitTokenLock(scLock).catch(() => {});');
+  expect(code.indexOf('await closeStitchSettlement(scSettleId, uid)', single)).toBeGreaterThan(single);
+  const commit = code.indexOf("name: 'commit'");
+  expect(code.indexOf('await closeStitchSettlement(sagaSettleId, uid)', commit)).toBeGreaterThan(commit);
+});
