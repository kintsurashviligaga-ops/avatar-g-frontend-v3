+/**
+ * Delete a still-live row owned by `userId` (status pending/processing). Used to close a durable settlement row
+ * (lib/orchestrator/stitchSettlement) once its attempt settled in-route, so the drainer has nothing left to refund.
+ * A final row and another user's row are never touched. Best-effort, never throws; true when a row was removed.
+ */
+export async function discardLiveJob(id: string, userId: string): Promise<boolean> {
+  const sb = client();
+  if (!sb || !id || !userId) return false;
+  try {
+    const { data, error } = await sb.from(TABLE).delete().eq('id', id).eq('user_id', userId).in('status', [...LIVE_STATUSES]).select('id');
+    if (error) {
+      reportError(new Error(error.message), { fn: 'discardLiveJob', id });
+      return false;
+    }
+    return Array.isArray(data) && data.length > 0;
+  } catch (e) {
+    reportError(e, { fn: 'discardLiveJob', id });
+    return false;
+  }
+}
+
 /** Mark a live job failed with a short reason. False when it was already final (a delivered job never turns failed). */
 export async function failJob(id: string, error: string): Promise<boolean> {
   const moved = await transition(id, { status: 'failed', current_stage: 'failed', error: error.slice(0, 300) }, 'failJob');
diff --git a/lib/orchestrator/stitchSettlement.test.ts b/lib/orchestrator/stitchSettlement.test.ts
