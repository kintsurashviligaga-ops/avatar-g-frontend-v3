# Myavatar.ge environment template
# Copy to .env.local for local development.

# ------------------------------
# Core app and Supabase
# ------------------------------
# Required for most authenticated/data-backed workflows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co

# ------------------------------
# Base URL (set at least one)
# ------------------------------
# Preferred public base URL used by links/metadata.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Server-side fallback base URL if NEXT_PUBLIC_BASE_URL is not set.
BASE_URL=http://localhost:3000

# Optional legacy URL aliases used by older modules.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_PHONE_AUTH_ENABLED=false
NEXT_PUBLIC_FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_PENTAGON_API_URL=

# ------------------------------
# Stripe (required only when Stripe is enabled/used)
# ------------------------------
# Set ENABLE_STRIPE=true to enforce Stripe requirements.
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=

# ------------------------------
# Optional production hardening
# ------------------------------
# Comma-separated origins for API CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional monitoring/analytics.
SENTRY_DSN=
VERCEL_ANALYTICS_ID=
ADMIN_KEY=
MIGRATION_RUN_KEY=

# ------------------------------
# Optional AI/storage providers
# ------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=claude-opus-4.6-fast
PROVIDER_MODE=real
DEEPSEEK_API_KEY=
GROQ_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
UDIO_API_KEY=
# Base URL for Udio API (supports https://udioapi.pro and compatible gateways)
UDIO_API_URL=https://udioapi.pro
# Optional path overrides
UDIO_GENERATE_PATH=/api/v2/generate
UDIO_FEED_PATH=/api/v2/feed
UDIO_MODEL=chirp-v4-5
UDIO_POLL_INTERVAL_MS=5000
UDIO_MAX_POLL_ATTEMPTS=40
# The music panel's native controls on the Udio gateway (gender / style_weight / weirdness_constraint). OFF until one
# live probe confirms the gateway accepts those fields (lib/udio/client.ts sunoControlFields). 1 = send them.
MUSIC_SUNO_PARAMS=0
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_GEORGIAN_VOICE_ID=

# ------------------------------
# Higgsfield — primary image + video provider. SERVER-SIDE ONLY.
# Never put these under NEXT_PUBLIC_*; @higgsfield/client v2 refuses to run in a browser anyway.
# Create SEPARATE dev + prod credentials in https://console.higgsfield.ai
# (Vercel: Preview <- dev pair, Production <- prod pair). Wire header: "Authorization: Key ID:SECRET".
# ------------------------------
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Single-variable form the SDK also reads ("id:secret"). Set the pair above OR this — not both.
HF_CREDENTIALS=
# OUR secret (not Higgsfield's): signs the ?hf_webhook= callback URL so a forged "completed" cannot settle a job.
HF_WEBHOOK_SECRET=
# GEL price of an estimate = usd x HF_USD_GEL_RATE x HF_GEL_MARGIN. Rate defaults to lib/billing/fx.ts; margin to 1.35.
HF_USD_GEL_RATE=
HF_GEL_MARGIN=1.35
# Comma-separated registry ids this account really has (lib/providers/registry.ts). Empty = all registered.
HF_ENABLED_MODELS=
# Account-wide in-flight limit enforced by the Redis semaphore (docs example: 4). Match the Console value.
HF_MAX_CONCURRENCY=4
# Public https origin Higgsfield can POST webhooks to. Defaults to NEXT_PUBLIC_APP_URL. A Preview deployment
# behind Vercel auth is NOT reachable — Preview then relies on the sweep cron's status polling.
HF_WEBHOOK_BASE_URL=
# Override only for testing against a mock. Default https://api.higgsfield.ai
HF_API_BASE_URL=
# The new studio routes (/api/estimate, /api/generate, /api/studio/models) exist only when this is 1.
# Preview first, then Production (brief §9). The webhook and the sweep cron are never gated.
STUDIO_V2=

VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Realtime V2V voice (websocket + low-latency providers)
VOICE_V2V_WS_URL=ws://localhost:8787/realtime
NEXT_PUBLIC_VOICE_V2V_WS_URL=ws://localhost:8787/realtime
VOICE_V2V_WS_TOKEN_SECRET=
VOICE_V2V_STT_PROVIDER=openai
VOICE_V2V_TTS_PROVIDER=elevenlabs
VOICE_V2V_STT_MODEL=gpt-4o-mini-transcribe
VOICE_V2V_LLM_MODEL=gpt-4o-mini
VOICE_V2V_DEEPGRAM_MODEL=nova-2
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Google Gemini (Multimodal  primary analysis engine)AI 
GEMINI_API_KEY=
# Model overrides — leave EMPTY for the code defaults in lib/ai/google/models.ts. Retired ids (gemini-1.x,
# gemini-2.0-*) are ignored: Google answers 404 for them. These are ids, so check GET /v1beta/models first.
# ⚠️ gemini-2.5-flash / -pro / -flash-lite are still LISTED by models.list but answer 404 "no longer available to new
# users" on a key from a new Google project — only a 1-token generateContent call tells. Do not pin them.
#   GEMINI_MODEL_PRO / GEMINI_MODEL_FLASH — REST client tiers (default gemini-3.1-pro-preview / gemini-3.8-flash)
#   GEMINI_CHAT_MODELS / GEMINI_CHAT_PRO_MODELS — chat rotation, comma list, fast first
#     (default gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash / gemini-3.1-pro-preview)
GEMINI_MODEL_PRO=
GEMINI_MODEL_FLASH=
GEMINI_CHAT_MODELS=
GEMINI_CHAT_PRO_MODELS=
GEMINI_MAX_TOKENS=4096
# ⚠️ LEAVE THIS EMPTY. It is an OPT-OUT kill switch, not an opt-in: isEnabledByDefault() treats
# 0/false/no/off as DISABLED and anything else — including empty — as enabled. The template used to ship
# `=false`, so every environment copied from it silently turned OFF Gemini Live voice and quietly
# degraded to the ElevenLabs stack. The one document a new deployment follows was disabling the feature
# the codebase considers primary. Set it to `false` ONLY as a deliberate revert.
NEXT_PUBLIC_GEMINI_LIVE_ENABLED=
# Digital Twin v0 (consent → three face photos → a voice sample, all in the private `twins` bucket; /api/twin/*).
# OFF by default and stays off until legal approves the consent text in lib/legal/content.ts (it is marked as a draft).
# A public build-time flag: changing it needs a redeploy. The phone link and the capture ticket are signed with
# AVATAR_HANDOFF_SECRET (falling back, loudly, to the service-role key).
NEXT_PUBLIC_TWIN_ENABLED=

# ── SCHEDULED WORK (Vercel Cron) ────────────────────────────────────────────────────────────────────
# ⚠️ WITHOUT CRON_SECRET EVERY CRON IS REFUSED. The handlers fail CLOSED by design (an unset secret
# means "locked", never "unchecked"), so with this absent the refund reaper never runs and the
# Telegram/WhatsApp queue is never drained — both fail silently, because a cron that 403s looks
# identical to a cron that has nothing to do. Vercel sends it as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional. Lets a server-to-server caller drive /api/app/worker/tick directly via the
# x-internal-worker-token header. Scheduled runs use CRON_SECRET above, so this is NOT required.
WORKER_INTERNAL_TOKEN=
# Set to 1 to arm the abandoned-render reaper (refunds reserves on jobs stuck >30min). Ships INERT.
RENDER_DRAINER_ENABLED=

# Chat model picker (lib/chat/chatModes.ts): per-account daily Pro turns (default 20; 0 turns Pro off) and an
# optional operator override of the Lite chain (ids outside the Flash-Lite class are dropped).
CHAT_PRO_DAILY_LIMIT=
GEMINI_CHAT_LITE_MODELS=

# ── INFRASTRUCTURE NAMES THE CODE READS (Phase 8.20 audit; values live in Vercel, never here) ──────────
# Rate limits + task relay (fail-open when unset):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Email + admin list + request signing secrets (secrets: generate in Vercel, never commit):
RESEND_API_KEY=
ADMIN_EMAILS=
CSRF_SECRET=
AGENT_G_QUOTE_SECRET=
MODEL3D_CHARGE_SECRET=
AVATAR_HANDOFF_SECRET=
FILM_FOLLOW_SECRET=
# Model pins (unset = code default; set only to roll back):
GEMINI_LIVE_MODEL=
VERTEX_OMNI_MODEL=
NEXT_PUBLIC_LIVE_AVATAR=
# Monitoring / analytics:
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── LAUNCH SWITCHES (Phase 8.14) ─────────────────────────────────────────────────────────────────────
# ⚠️ THE VALUES DIFFER PER FEATURE. A value a reader does not accept leaves the feature OFF with no error.
# The full table, with each reader's file: docs/launch/ENV_REGISTRY.md (generated from lib/env/launchFlags.ts).
# After a change, GET /api/admin/launch-flags (admins) lists every switch as the code reads it, plus warnings.
# All ship empty = OFF. NEXT_PUBLIC_ names are baked in at build time: change them, then redeploy.
#
# admin | everyone ONLY ('1', 'true', 'on' and 'admins' are OFF):
STUDIO_3D_V2=
NEXT_PUBLIC_STUDIO_3D_V2=
MONTAGE_SMART_EDITOR=
NEXT_PUBLIC_MONTAGE_SMART_EDITOR=
DIRECTORS_WORKFLOW=
IMAGE_ART_DIRECTOR=
NEXT_PUBLIC_IMAGE_ART_DIRECTOR=
MUSIC_PRODUCER_V2=
NEXT_PUBLIC_MUSIC_PRODUCER_V2=
AVATAR_STUDIO_V2=
NEXT_PUBLIC_AVATAR_STUDIO_V2=
# 3D Studio worker (Cloud Run GPU job, europe-west4). STUDIO_3D_DAILY_CAP = jobs per UTC day site-wide (default 200).
STUDIO_3D_JOB=
STUDIO_3D_REGION=
STUDIO_3D_GCP_PROJECT=
STUDIO_3D_TIMEOUT_SEC=
STUDIO_3D_DAILY_CAP=
#
# admins | everyone ONLY (here 'admin' without the s is OFF):
AGENT_REEL_TASK=
# admin | admins | everyone | on | 1 | true:
AGENT_ENGINE_MEDIA=
# admin | admins (admins only by design, no everyone value):
AGENT_BROWSER_AGENT=
AGENT_APP_BUILDER=
AGENT_SANDBOX_PACKAGES=
# admin | 1 | true | on (no 'everyone'; CONNECTORS_DRIVE also takes 'all' but not 'admins'):
AGENT_G_SANDBOX=
AGENT_G_MEDIA_EXEC=
AGENT_G_FILE_ANALYSIS=
CONNECTORS_DRIVE=
# Sealing key for connector refresh tokens (AES-256-GCM, 32 bytes base64). Secret.
CONNECTOR_TOKEN_KEY=
#
# Exactly '1' (no 'true', no spaces). BROWSER_ENABLED also needs BROWSER_SNAPSHOT_ID; AGENT_BROWSER_LOGIN needs the vault key.
BROWSER_ENABLED=
BROWSER_SNAPSHOT_ID=
SANDBOX_ENABLED=
AGENT_BROWSER_LOGIN=
AGENT_BROWSER_VAULT_KEY=
NEXT_PUBLIC_CLIENT_ERROR_REPORTS=
# Phase 8.10 / 8.20 (exactly '1'): Agent G shield, memory deadline, Live planner, router v2, commands, goal pin.
AGENT_G_SHIELD=
AGENT_G_CONTEXT_V2=
LIVE_AGENT_PLANNER=
NEXT_PUBLIC_AGENT_G_ROUTER_V2=
NEXT_PUBLIC_AGENT_G_COMMANDS=
NEXT_PUBLIC_CHAT_PIN_GOAL=
# EU AI Act (exactly '1'). AI_PROVENANCE_META = invisible XMP metadata. NEXT_PUBLIC_AI_LABELS = visible badges: stays OFF (GG 2026-11-27).
AI_PROVENANCE_META=
NEXT_PUBLIC_AI_LABELS=
# Production only: refuse a debit the ledger answers 'skipped' instead of rendering free (#407). Billing: GG card.
LEDGER_FAIL_CLOSED=
#
# Exactly on | 1 | true (billing: only by GG's card, after the v8 SQL):
NEXT_PUBLIC_PRICING_V8=
ADMIN_FINANCE_DASHBOARD=
# 1 | true | on | yes:
AGENT_VALIDATE=
AUTH_LOCAL_CLAIMS=
TASK_RELAY_TICKET=
CHAT_MEDIA_RENEW=
CLIP_ADVANCED=
NEXT_PUBLIC_CLIP_ADVANCED=
CLIP_LAST_FRAME=
NEXT_PUBLIC_CLIP_LAST_FRAME=
NEXT_PUBLIC_MUSIC_UX_V2=
NEXT_PUBLIC_INTERIOR_UX_V2=
READ_ALOUD_VOICE_V2=
IMAGE_EXTRA_RATIOS=
NEXT_PUBLIC_IMAGE_EXTRA_RATIOS=
IMAGE_MULTI_REF=
NEXT_PUBLIC_IMAGE_EDIT_MODE=
# 'everyone' opens to all; anything else = admins only (prod today: everyone):
LIVE_AUDIENCE=
LIVE_AVATAR_AUDIENCE=
