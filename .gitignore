out/
# ANCHORED to the repo root. A bare `build/` matches at ANY depth, and it silently swallowed
# app/api/v2/presentation/build/route.ts — the entire Presentation service was never committed, so
# production 404s it while vercel.json and next.config.js still configure the function. `git status`
# stayed clean throughout, because ignored files are never reported as untracked.
/build/
dist/
coverage/
logs/
.env
.env.local
.DS_Store
*.log
node_modules_old/
tsconfig.tsbuildinfo
.vercel
.env*.local
test-results/
playwright-report/

# Debug/temp files
__*.txt
tmp_*
zz_*
build_result.txt
build_output*.txt
build_check.txt
build_log.txt
build-log.txt
build-output.txt
build-cro-output.txt
build.txt
deps-exit.txt
errors.txt
jest-exit.txt
response.txt
devlog_tmp.txt
repo-tree-full.txt
app-directories.txt
app-tree-exact.txt
lint-report*.json
lint-target-summary.txt
copilot_marker.txt
vercel-project-inspect.txt

# Art packs (scripts/hf-art-pack.ts): every raw take stays local, in the pack's work dir OUTSIDE public/ (which deploys).
# brand/v1 — only the selected masters (design/brand/v1/*.jpg|mp4) and the manifest are committed.
/design/brand/v1/raw/
# The old raw locations (before 2026-10-01): still ignored, so a take left there locally is never committed.
/public/brand/v1/raw/
/public/templates/raw/

# GCP service-account keys (scripts/gcp/setup-veo-vertex.sh writes one) — a long-lived secret, never committed.
*-key.json
*service-account*.json

# Template gallery thumbnails: raw takes stay local (only the manifest and the selected, resized cards are committed).
/scripts/templates/raw/
# Site imagery v2 (VFX presets, video hero banners, service cards, image style swatches): raw takes and contact sheets
# stay local — only the manifest and the selected, resized finals under public/ are committed.
/scripts/site-art/raw/
